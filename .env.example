# URL base de Jira, sin /rest/api/2 al final.
JIRA_HOST=https://jira.example.com

# Clave del proyecto destino.
JIRA_PROJECT_KEY=MYPROJ

# Elige UNA alternativa de autenticación:
#
# 1) Cabecera Basic ya codificada en Base64, con o sin el prefijo "Basic ".
# JIRA_AUTH_BASIC=Basic base64-encoded-credentials
#
# 2) Token que el servidor Jira acepta como Bearer.
# JIRA_API_TOKEN=your-api-token

# Opcional: nombres de los tipos de incidencia definidos en tu proyecto Jira.
# JIRA_ISSUE_TYPE=Task
# JIRA_SUBTASK_ISSUE_TYPE=Sub-task

# Opcional: token OAuth2/Bearer utilizado solamente para las pruebas de endpoints.
# No se persiste en el informe de baseline.
# AUTH_TOKEN=your-oauth2-or-bearer-token

# Opcional: configuración para consultar métricas de SonarQube durante Estación 2.
# El token se envía únicamente en la cabecera Authorization y no se persiste.
# SONAR_HOST_URL=https://sonar.example.com
# SONAR_TOKEN=your-sonar-token
